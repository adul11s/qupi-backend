DATABASE_URL="postgresql://qupi:qupi@localhost:5432/qupi?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="ganti-dengan-secret-yang-kuat"
# Fase-4 #1: WAJIB (fail-closed) — tanpa ini endpoint internal/callback ditolak 403,
# dan startup production ditolak. Generasi: openssl rand -hex 32
WALLET_CALLBACK_SECRET="ganti-dengan-$(openssl rand -hex 32 2>/dev/null || echo random-string)"
PORT=3000
PIN_MAX_ATTEMPTS=5
OTP_TTL_MINUTES=5
OTP_MAX_PER_MINUTE=3
SESSION_IDLE_MINUTES=15
# Simulator provider eksternal (mode: success | fail | timeout), memaksa mode untuk semua provider
PROVIDER_MODE=success
