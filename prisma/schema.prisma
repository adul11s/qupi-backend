
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  LOCKED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  UPLOAD_AGAIN
}

enum TxStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TxKind {
  TOPUP
  TRANSFER
  QRIS
  BILL
  INSTALLMENT
  PAYLATER_PURCHASE
}

enum Direction {
  DEBIT
  CREDIT
}

enum InstallmentStatus {
  UNPAID
  PAID
  LATE
}

enum BillProvider {
  PLN
  PULSA
  DATA
}

enum BillStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id                String         @id @default(cuid())
  phone             String         @unique
  name              String
  status            UserStatus     @default(ACTIVE)
  pinHash           String?
  failedPinAttempts Int            @default(0)
  isAdmin           Boolean        @default(false)
  // Fase-3 #5: default 4jt DIHAPUS — penghasilan harus diverifikasi admin
  // (POST /admin/users/:id/income) sebelum limit PayLater dapat dihitung.
  monthlyIncome     Int?
  kycTier           String         @default("T1")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  otpCodes          OtpCode[]
  loginAttempts     LoginAttempt[]
  kycDocuments      KycDocument[]
  wallet            WalletAccount?
  payLaterLines     PayLaterLine[]
  sessions          Session[]
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  purpose    String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model KycDocument {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  kind            String
  fileUrl         String
  status          KycStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WalletAccount {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id])
  balance       Int           @default(0)
  createdAt     DateTime      @default(now())
  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id            String        @id @default(cuid())
  accountId     String
  account       WalletAccount @relation(fields: [accountId], references: [id])
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  direction     Direction
  amount        Int
  createdAt     DateTime      @default(now())

  @@index([accountId])
}

model Transaction {
  id             String        @id @default(cuid())
  idempotencyKey String        @unique
  kind           TxKind
  status         TxStatus      @default(PENDING)
  amount         Int
  counterparty   String?
  userId         String?
  failReason     String?
  // Fase-3 #2: idempotency key di-bind ke payload (fingerprint) — replay hanya
  // jika key sama DAN fingerprint sama; beda fingerprint → 409 IDEM_CONFLICT.
  fingerprint    String?
  createdAt      DateTime @default(now())
  ledgerEntries  LedgerEntry[]

  @@index([userId, kind, createdAt])
}

model PayLaterLine {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  limitAmount Int
  used        Int          @default(0)
  activated   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  payLaterTxs PayLaterTx[]
}

model PayLaterTx {
  id             String   @id @default(cuid())
  lineId         String
  line           PayLaterLine @relation(fields: [lineId], references: [id])
  amount         Int
  totalAmount    Int
  totalInterest  Int
  tenorMonths    Int      @default(1)
  idempotencyKey String   @unique
  // Fase-3 #2: binding idempotensi ke payload (lihat Transaction.fingerprint).
  fingerprint    String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  installments   PayLaterInstallment[]
}

model PayLaterInstallment {
  id          String            @id @default(cuid())
  payLaterTxId String
  payLaterTx  PayLaterTx        @relation(fields: [payLaterTxId], references: [id])
  seq         Int
  dueAt       DateTime
  amount      Int
  penalty     Int               @default(0)
  status      InstallmentStatus @default(UNPAID)
  paidAt      DateTime?
  transactionId String?         @unique

  @@unique([payLaterTxId, seq])
}

model Bill {
  id            String       @id @default(cuid())
  userId        String
  provider      BillProvider
  number        String
  amount        Int
  status        BillStatus   @default(PENDING)
  transactionId String?      @unique
  inquiryKey    String       @unique
  createdAt     DateTime     @default(now())
}

model Session {
  id             String    @id @default(cuid())
  token          String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  lastActivityAt DateTime  @default(now())
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model QrisPayment {
  id            String    @id @default(cuid())
  userId        String
  merchantId    String
  merchantName  String
  amount        Int
  status        String    @default("PENDING")
  qrisPayload   String
  transactionId String?   @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}
